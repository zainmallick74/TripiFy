<% layout("/layouts/boilerplate") %>

<div class="show-img-section">

    <div class="row justify-content-center">

        <div class="show-page-content">

            <h2 class="mb-3"><%= listing.title %></h2>

            <div class="slider-container">

                <button id="prevBtn" class="slider-btn">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <div class="image-container">
                    <% for(let image of listing.images) { %>
                        <img
                            src="<%= image.url %>"
                            class="show-img gallery-image"
                            alt="listingImage"
                        >
                    <% } %>
                </div>

                <button id="nextBtn" class="slider-btn">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

            </div>

            <div class="listing-details">

                <p class="card-text">
                    Owned by <i><%= listing.owner.username %></i>
                </p>

                <p class="card-text">
                    <strong>Description:</strong>
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>Price:</strong>
                    &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
                </p>

                <p class="card-text">
                    <strong>City:</strong>
                    <%= listing.city %>
                </p>

                <p class="card-text">
                    <strong>State:</strong>
                    <%= listing.state %>
                </p>

                <p class="card-text">
                    <strong>Country:</strong>
                    <%= listing.country %>
                </p>

                <p class="card-text">
                    <strong>Type:</strong>
                    <%= listing.type %>
                </p>

               <% if(currUser && currUser.role === "guest") { %>

                <form action="/bookings/<%=listing._id%>" method="POST">
                   <button type="submit" class="book-property-btn">
                       <i class="fa-solid fa-plus"></i>
                       Book property
                   </button>
                </form>

               <% } %>

                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>

                    <div class="d-flex gap-3 mt-4">

                        <form
                            method="GET"
                            action="/listings/<%= listing._id %>/edit">

                            <button class="btn btn-warning">
                                Edit
                            </button>

                        </form>

                        <form
                            method="POST"
                            action="/listings/<%= listing._id %>?_method=DELETE">

                            <button class="btn btn-danger">
                                Delete
                            </button>

                        </form>

                    </div>

                <% } %>

            </div>

        </div> 

    </div> 

    <div class="review-section">

        <% if(currUser) { %>

            <hr>

            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listing.id %>/reviews"
                method="POST"
                class="needs-validation"
                novalidate>

                <fieldset class="starability-basic">

                    <legend>First rating:</legend>

                    <input type="radio" id="no-rate" class="input-no-rate"
                        name="review[rating]" value="0" checked
                        aria-label="No rating." />

                    <input type="radio" id="first-rate1"
                        name="review[rating]" value="1" />
                    <label for="first-rate1">1 star</label>

                    <input type="radio" id="first-rate2"
                        name="review[rating]" value="2" />
                    <label for="first-rate2">2 stars</label>

                    <input type="radio" id="first-rate3"
                        name="review[rating]" value="3" />
                    <label for="first-rate3">3 stars</label>

                    <input type="radio" id="first-rate4"
                        name="review[rating]" value="4" />
                    <label for="first-rate4">4 stars</label>

                    <input type="radio" id="first-rate5"
                        name="review[rating]" value="5" />
                    <label for="first-rate5">5 stars</label>

                </fieldset>

                <div>

                    <label>Comments</label>

                    <textarea
                        name="review[comment]"
                        id="comment"
                        rows="5"
                        class="form-control review-text"
                        required></textarea>

                    <div class="invalid-feedback">
                        Please submit some review
                    </div>

                </div>

                <button class="btn btn-outline-dark mt-3">
                    Submit
                </button>

            </form>

        <% } %>

        <hr>

        <h3 class="mt-4 mb-3">Guest Reviews</h3>

        <div class="row">

            <% for(let review of listing.reviews) { %>

                <div class="col-md-6 mb-3">

                    <div class="card shadow-sm border-0 h-100 guest-review">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <h5 class="card-title mb-0">
                                    <i class="fa-solid fa-user-circle"></i>
                                    @<%= review.author.username %>
                                </h5>

                                <span class="badge bg-dark">
                                    ⭐ <%= review.rating %>/5
                                </span>

                            </div>

                            <hr>

                            <p class="card-text">
                                <%= review.comment %>
                            </p>

                        </div>

                        <form
                            class="mb-3"
                            method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                            <button class="btn btn-sm btn-dark">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% } %>

        </div>

    </div> <!-- review-section -->

</div> <!-- show-img-section -->

<script src="/js/slider.js"></script>