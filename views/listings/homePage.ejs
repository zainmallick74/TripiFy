<% layout("/layouts/boilerplate")%>

   <div class="hero-section">
  
     <div class="hero-content">

    
       <div class="text-part">
         <!-- all the text -->
         <h1 class="heading">Find your next adventure</h1>

         <p class="text">Discover unique homes, villas and cabins around the world.  </p>

         <a href="/listings" class="hero-btn">
           Explore more
           <i class="fa-solid fa-arrow-right"></i>
         </a>

        </div>

        <div class="image-part">
           <!-- image -->
           <img src="/images/heroPageImage.webp"  class="heroImage"/>
        </div>

    </div>
   
</div>

<div class="categories">
  <div class="divider"></div>
  <div class="category-heading">
      <p class="category-subtitle">EXPLORE</p>
      <h2 class="category-title">Browse by Category</h2>
  </div>

  <div class="section-grid">
    <!-- All cards -->
     <a href="/listings" class="category-card">
        <div class="section-card">
        <i class="fa-solid fa-fire"></i>
        <p class="card-text">Trending</p>
       </div>
     </a>

     <a href="/listings?type=rooms" class="category-card">
       <div class="section-card">
         <i class="fa-solid fa-bed"></i>
         <p  class="card-text">Rooms</p>
       </div>
     </a>

    <a href="/listings?type=cities" class="category-card">
    <div class="section-card">
     <i class="fa-solid fa-mountain-city"></i>
     <p class="card-text">iconic cities</p>
    </div>
    </a>

    <a href="/listings?type=mountain" class="category-card">
    <div class="section-card">
       <i class="fa-duotone fa-regular fa-mountain"></i>
       <p class="card-text">Mountains</p>
    </div>
    </a>

    <a href="/listings?type=castles" class="category-card">
    <div class="section-card">
        <i class="fa-brands fa-fort-awesome"></i>
        <p class="card-text">castles</p>
    </div>
    </a>

    <a href="/listings?type=swimming" class="category-card">
    <div class="section-card">
      <i class="fa-solid fa-person-swimming"></i>
      <p class="card-text">swimming pool</p>
    </div>
    </a>

    <a href="/listings?type=camping" class="category-card">
    <div class="section-card">
       <i class="fa-solid fa-tent"></i>
      <p class="card-text">camping</p>
    </div>
    </a>

    <a href="/listings?type=arctic" class="category-card">
    <div class="section-card">
      <i class="fa-regular fa-snowflake"></i>
      <p class="card-text">Arctic </p>
    </div>
    </a>

    <a href="/listings?type=farms" class="category-card">
    <div class="section-card">
       <i class="fa-solid fa-truck-field"></i>
      <p class="card-text">Farms </p>
    </div>
    </a>

  </div>

 <div class="destination-page">

  <div class="divider"></div>

  <div class="section-heading">
    <p class="section-tag">FEATURED DESTINATIONS</p>
    <h2>Explore the world's best places.</h2>
    <p class="section-description">Find unforgettable stays in breathtaking location </p>

  </div>

  <div class="destination-cards">
    
    <a href="/listings?city=bali">
    <div class="destination-card">
      <img src="/images/Bali.webp" />
      <div class="destination-info">
        <p>Bali</p>
        <p>85+ premium stays</p>
      </div>
    </div>
    </a>

    <a href="/listings?city=london">
    <div class="destination-card">
      <img src="/images/London.webp" />
      <div class="destination-info">
       <p>London</p>
       <p>70+ premium stays</p>
       </div>
    </div>
    </a>

    <a href="/listings?city=paris">
    <div class="destination-card">
      <img src="/images/Paris.webp" />
      <div class="destination-info">
      <p>France</p>
      <p>65+ premium stays</p>
      </div>
    </div>
    </a>

    <a href="/listings?city=rome">
    <div class="destination-card">
      <img src="/images/Rome.webp" />
      <div class="destination-info">
      <p>Italy</p>
      <p>100+ premium stays</p>
       </div>
    </div>
    </a>

  </div>

 </div>



  <div class="divider"></div>

    <div class="feature-section">
     
       
        <div class="feature-section-internal">

          <div class="section-heading">
             <p class="section-tag">WHY CHOOSE TRIPIFY</p>
             <h2>Travel with confidence</h2>
             <p class="section-description">we make booking your perfect stay effortless, secure, and enjoyable every time. </p>
          </div>

          <div class="feature-grid">

            <div class="feature-card">
              <i class="fa-solid fa-shield-halved"></i>
              <div class="feature-text">
                 <h1>Secure Booking</h1>
                 <p>Book with confidence through our secure and encrypted payment system</p>
                
              </div>
            </div>

            <div class="feature-card">
              <i class="fa-solid fa-circle-check"></i>
              <div>
                 <h1>Verified Property</h1>
                 <p>Every property is carefully reviewed to ensure quality and authenticity.</p>
              </div>
            </div>

            <div class="feature-card">
              <i class="fa-solid fa-tags"></i>
              <div>
                 <h1>Best Price Guarantee</h1>
                 <p>Enjoy competitive prices without compromising on comfort..</p>
              </div>
            </div>

            <div class="feature-card">
              <i class="fa-solid fa-headset"></i>
              <div>
                 <h1>24/7 Customer Support</h1>
                 <p>Our support team is always ready to help whenever you need assistance..</p>
              </div>
            </div>

          </div>

        </div>

    </div>


</div>





