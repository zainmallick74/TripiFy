<% layout("/layouts/boilerplate") %>

<div class="signup-page">

    <div class="signup-form-content">

        <h2 class="signup-form-heading">Create your TripiFy Account</h2>

        <p class="signup-subtitle">
            Join TripiFy and start exploring amazing destinations.
        </p>

        <form action="/signup" method="POST" class="needs-validation" novalidate>

            <div class="signup-input-group">
                <label for="username" class="signup-label form-label">
                    Username
                </label>

                <input
                    name="username"
                    id="username"
                    type="text"
                    class="signup-input form-control"
                    required
                />

                <div class="valid-feedback">
                    Looks good
                </div>
            </div>

            <div class="signup-input-group">

                <label for="email" class="signup-label form-label">
                    Email
                </label>

                <input
                    name="email"
                    id="email"
                    type="email"
                    class="signup-input form-control"
                    required
                />

            </div>

            <div class="signup-input-group">

                <label for="password" class="signup-label form-label">
                    Password
                </label>

                <input
                    name="password"
                    id="password"
                    type="password"
                    class="signup-input form-control"
                    required
                />

            </div>

            <div class="role-selection">

                <label for="role">Account Type</label>

                <select name="role" id="role" class="role-type" required>
                   <option value="">Select Your Role</option>
                   <option value="guest">Guest</option>
                   <option value="landlord">Landlord</option>
                </select>

            </div>

            <button class="signup-btn">
                Create Account
            </button>

        </form>

    </div>

</div>